#================================================================
# 我家云 L1Pro（RK3328 / ARMv8 64bit）精简固件 .config —— 极简版
# 严格只留三件事：基础上网、Docker、OpenClash
# 用法：编译时由工作流复制为 openwrt/.config，再 make defconfig 自动补齐依赖
#
# 说明：下面每一行都是「删掉就会坏」的，不是可选功能。
#      依赖树（containerd/runc/luci 组件等）由 defconfig 自动拉取，不在此列出。
#================================================================

#---------------------------------------------------------------
# 目标平台：armsr/armv8（RK3328 是 64 位 ARM，l1pro 打包脚本吃这个 rootfs）
#---------------------------------------------------------------
CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_armv8=y
CONFIG_TARGET_ROOTFS_TARGZ=y
# 允许按需自动拉取内核模块（Docker/OpenClash 依赖 kmod）
CONFIG_ALL_KMODS=y

#---------------------------------------------------------------
# 1) 基础上网 + 管理后台（删掉任何一条都会失去网络或后台）
#---------------------------------------------------------------
# LuCI 后台本体 + 新式 LuCI 组件兼容层
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
# 后台中文（只要界面中文；防火墙/系统/网络等子页面汉化可按需另加）
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
# DHCP + DNS：OpenClash 要求 dnsmasq-full，必须顶掉默认 dnsmasq
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
# 防火墙4（ImmortalWrt 24.10 / OpenWrt 23.05+ 默认 nftables 栈）
CONFIG_PACKAGE_firewall4=y
# 局域网 DHCP 服务
CONFIG_PACKAGE_odhcpd-ipv6only=y
# ip/nft 命令行（OpenClash 写转发规则必需）
CONFIG_PACKAGE_ip-full=y

#---------------------------------------------------------------
# 2) OpenClash 及其硬依赖（按官方 README 的 nftables 依赖清单，逐条对应）
#---------------------------------------------------------------
# 插件本身：由工作流从 vernesong/OpenClash 拉源码随固件编译
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
# 解内核包与规则集
CONFIG_PACKAGE_unzip=y
# OpenClash 脚本用 ruby 解析 YAML —— 体积不小但绝对不可删
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
# TUN 模式 / 进程名分流规则 / nftables 透明代理
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-tproxy=y

#---------------------------------------------------------------
# 3) Docker（24.10 起拆成守护进程与命令行两个包，CLI 不装等于没有 docker 命令）
#---------------------------------------------------------------
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker-cli=y

#================================================================
# 可选（默认关闭，按需删行开启；都只加一两行，不影响上面的极简结构）
#================================================================
# Docker 网页管理界面（只要命令行就别开）
# CONFIG_PACKAGE_luci-app-dockerman=y
# 后台上传文件用的 SFTP 服务端（手动传 OpenClash 内核时很方便）
# CONFIG_PACKAGE_openssh-sftp-server=y
# 防火墙/系统/网络等子页面完整汉化
# CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
# CONFIG_PACKAGE_luci-i18n-system-zh-cn=y
# CONFIG_PACKAGE_luci-i18n-network-zh-cn=y
# 容器编排
# CONFIG_PACKAGE_docker-compose=y
# IPv6 WAN（默认不装；换 lede / 老版本源码走 iptables 路线时，另需
# iptables、iptables-mod-tproxy、iptables-mod-extra、ipset 一组，此处按
# nftables 路线整组省掉）
# CONFIG_PACKAGE_odhcp6c=y
# CONFIG_PACKAGE_ip6tables-mod-nat=y
# openssl 命令行工具。OpenClash 的部分功能（配置文件加密、生成密钥等）会调用它。
# 若编译后用不到这些功能可不开；遇到相关报错就取消注释重编。
# CONFIG_PACKAGE_openssl-util=y

#================================================================
# 明确排除（保持极简，勿解注释）
#================================================================
# CONFIG_PACKAGE_luci-app-samba4 is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-ttyd is not set
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-app-qos is not set
# CONFIG_PACKAGE_luci-app-nlbwmon is not set
# CONFIG_PACKAGE_luci-app-statistics is not set
# CONFIG_PACKAGE_luci-app-watchcat is not set
# CONFIG_PACKAGE_luci-app-wol is not set
# CONFIG_PACKAGE_luci-app-attendedsysupgrade is not set
# CONFIG_PACKAGE_adbyby is not set
# CONFIG_PACKAGE_turboacc is not set
# CONFIG_PACKAGE_ksmbd-tools is not set
# CONFIG_PACKAGE_samba4 is not set
# CONFIG_PACKAGE_vlmcsd is not set
# CONFIG_PACKAGE_wget-ssl is not set
# CONFIG_PACKAGE_luci-app-docker is not set
